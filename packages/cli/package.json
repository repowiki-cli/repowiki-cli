{
  "name": "repowiki-cli",
  "version": "0.1.2",
  "description": "AI-Native engineering toolkit for large-scale multi-repo projects",
  "bin": {
    "repowiki": "./bin/run.js"
  },
  "main": "./dist/index.js",
  "oclif": {
    "bin": "repowiki",
    "dirname": "repowiki",
    "commands": "./dist/commands",
    "plugins": [
      "@repowiki/plugin-wiki",
      "@repowiki/plugin-context",
      "@repowiki/plugin-spec"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@oclif/core": "^4.11.3",
    "@repowiki/plugin-context": "workspace:*",
    "@repowiki/plugin-spec": "workspace:*",
    "@repowiki/plugin-wiki": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "cli",
    "wiki",
    "llm",
    "context",
    "repowiki"
  ],
  "license": "MIT"
}
