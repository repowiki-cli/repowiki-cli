{
  "name": "@repowiki/plugin-wiki",
  "version": "0.0.1",
  "description": "RepoWiki generation plugin for repowiki-cli",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "oclif": {
    "commands": "./dist/commands",
    "bin": "repowiki"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts && tsup src/commands/wiki/generate.ts src/commands/wiki/update.ts src/commands/wiki/validate.ts --format cjs --dts --out-dir dist/commands/wiki",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@oclif/core": "^4.0.0",
    "@repowiki/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
