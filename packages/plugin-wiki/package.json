{
  "name": "@repowiki/plugin-wiki",
  "version": "0.3.0",
  "description": "RepoWiki generation plugin for repowiki-cli",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "oclif": {
    "commands": "./dist/commands",
    "bin": "repowiki"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@oclif/core": "^4.0.0",
    "@repowiki/core": "workspace:*",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.0",
    "ignore": "^5.3.0",
    "js-tiktoken": "^1.0.0",
    "openai": "^6.37.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-typescript": "^0.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
