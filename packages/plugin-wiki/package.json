{
  "name": "@repowiki/plugin-wiki",
  "version": "0.1.0",
  "description": "RepoWiki generation plugin for repowiki-cli",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "oclif": {
    "commands": "./dist/commands",
    "bin": "repowiki"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/check-workspace-refs.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@oclif/core": "^4.0.0",
    "@repowiki/core": "workspace:*",
    "dotenv": "^16.0.0",
    "fast-glob": "^3.3.0",
    "ignore": "^5.3.0",
    "js-tiktoken": "^1.0.0",
    "openai": "^4.0.0",
    "tree-sitter": "^0.22.0",
    "tree-sitter-typescript": "^0.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
