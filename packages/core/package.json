{
  "name": "@repowiki/core",
  "version": "0.0.1",
  "description": "Shared interfaces and types for repowiki-cli",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "*",
    "typescript": "^5.6.0",
    "vitest": "*"
  }
}
