{
  "name": "@repowiki/plugin-spec",
  "version": "0.0.2",
  "description": "SDD/ATDD generation plugin for repowiki-cli",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "oclif": {
    "commands": "./dist/commands",
    "bin": "repowiki"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@oclif/core": "^4.11.3",
    "@repowiki/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
